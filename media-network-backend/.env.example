# Copy to .env and adjust before deploying.
TZ=America/Chicago
# LAN IP of this host. Jellyfin/RustDesk ports bind here (use 0.0.0.0 for all interfaces).
BIND_IP=0.0.0.0
# Public hostname/IP that RustDesk clients use to reach the relay.
RUSTDESK_RELAY_HOST=support.example.com
# Host paths
MEDIA_PATH=./data/media
# UID/GID Jellyfin runs as (match owner of MEDIA_PATH)
PUID=1000
PGID=1000

# --- Jellyfin (native on Windows) ---
JELLYFIN_URL=http://host.docker.internal:8096
# Dashboard > API Keys in Jellyfin
JELLYFIN_API_KEY=
# --- Vidar dashboard: password for the web panel (required when exposed beyond localhost) ---
DASHBOARD_TOKEN=change-me
# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID(s), comma-separated. Only these can use the bot.
TELEGRAM_ALLOWED_IDS=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# --- Backups ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Optional rclone remote for an encrypted cloud copy, e.g. b2crypt:vidar
RCLONE_REMOTE=

# --- Media extras (docker compose --profile media up -d) ---
MUSIC_PATH=./data/media/music
AUDIOBOOKS_PATH=./data/media/audiobooks
PODCASTS_PATH=./data/media/podcasts
PHOTOS_PATH=./data/media/photos
IMMICH_DB_PASSWORD=change-me

# --- Security ---
# Public key from `age-keygen -o vidar-backup.key` (keep the .key file OFF the server, e.g. in Bitwarden)
BACKUP_AGE_RECIPIENT=
# Tailscale API key (admin → Settings → Keys) for the dashboard's lockdown button
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=-
# Cloudflare API token (Access: Apps and Policies Edit) for scripts/security/cloudflare-access.py
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ACCESS_ALLOWED_EMAILS=you@example.com
# Vaultwarden admin token (long random string)
VAULTWARDEN_ADMIN_TOKEN=
