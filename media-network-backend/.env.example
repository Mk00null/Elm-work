# Copy to .env and adjust before deploying.
TZ=America/Chicago
# LAN IP of this host. Jellyfin/RustDesk ports bind here (use 0.0.0.0 for all interfaces).
BIND_IP=0.0.0.0
# Public hostname/IP that RustDesk clients use to reach the relay.
RUSTDESK_RELAY_HOST=support.example.com
# Host paths
MEDIA_PATH=./data/media
# UID/GID Jellyfin runs as (match owner of MEDIA_PATH)
PUID=1000
PGID=1000
